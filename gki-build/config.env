# Reproducible defaults for the xaga HyperOS2 GKI kernel builder.
# Every value can be overridden by exporting the same name before build.sh.

KERNEL_NAME="${KERNEL_NAME:-ESKXAGA}"
TARGET_NAME="${TARGET_NAME:-xaga}"

# Base kernel tree: ESK v4.0.1 xaga source (Linux 5.10.274, android12-5.10 GKI).
KERNEL_REPO="${KERNEL_REPO:-https://github.com/ESK-Project/android_kernel_xiaomi_mt6895.git}"
KERNEL_REF="${KERNEL_REF:-5bf560ebb55ba873adf3f36a68e972ab3e89c58a}"
KERNEL_DEFCONFIG="${KERNEL_DEFCONFIG:-gki_defconfig}"
DEFCONFIG_OVERLAYS="${DEFCONFIG_OVERLAYS:-vendor/xiaomi_mt6895.config vendor/xaga.config}"

# ESK builder is used only for the device-specific vendor module load lists.
ESK_BUILDER_REPO="${ESK_BUILDER_REPO:-https://github.com/ESK-Project/esk_builder.git}"
ESK_BUILDER_REF="${ESK_BUILDER_REF:-d2ebf28b46eb3be4da5c9dd852efe3f0d595b6f0}"

# AnyKernel3 template that understands Image.zst + module.tar.xz on xaga.
AK3_REPO="${AK3_REPO:-https://github.com/ESK-Project/AnyKernel3.git}"
AK3_REF="${AK3_REF:-4a448ee5019fe076e1c48827af1cd0f0de72e68f}"

# AOSP clang used by ESK v4.0.1 (clang 23.0.1 / r614150).
CLANG_RELEASE_API="${CLANG_RELEASE_API:-https://api.github.com/repos/bachnxuan/aosp_clang_mirror/releases/tags/clang-r614150-16836431}"

# Official kernel-side SUSFS patches.
SUSFS_REPO="${SUSFS_REPO:-https://gitlab.com/simonpunk/susfs4ksu.git}"
SUSFS_REF="${SUSFS_REF:-gki-android12-5.10}"
ENABLE_SUSFS="${ENABLE_SUSFS:-1}"

# ESK v4.0.1 also enables NoMount; keep parity unless explicitly disabled.
ENABLE_NOMOUNT="${ENABLE_NOMOUNT:-1}"
NOMOUNT_SETUP_URL="${NOMOUNT_SETUP_URL:-https://raw.githubusercontent.com/maxsteeel/nomount/refs/heads/dev/kernel/setup.sh}"

# Module packaging is required for a bootable HyperOS2 xaga kernel.
ENABLE_MODULES="${ENABLE_MODULES:-1}"
CLANG_LTO="${CLANG_LTO:-thin}"
USE_CCACHE="${USE_CCACHE:-1}"
JOBS="${JOBS:-4}"

# Fixed build identity for reproducible images. Override if you need an exact OEM banner.
BUILD_USER="${BUILD_USER:-builder}"
BUILD_HOST="${BUILD_HOST:-xaga-gki-ci}"
KBUILD_BUILD_TIMESTAMP="${KBUILD_BUILD_TIMESTAMP:-Fri Mar 14 12:00:00 UTC 2026}"
KERNEL_LOCALVERSION="${KERNEL_LOCALVERSION:-}"
